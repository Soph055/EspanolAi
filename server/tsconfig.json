{
    "compilerOptions": {
      "target": "ES2022",
      "module": "commonjs",
      "lib": ["ES2022"],
      "outDir": "./dist",
      "rootDir": "./",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "declaration": false,
      "sourceMap": true,
      "noImplicitAny": true,
      "strictNullChecks": true
    },
    "include": ["**/*.ts", "types/**/*.d.ts"],
    "exclude": ["node_modules", "dist"]
  }